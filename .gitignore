tests/*
# Release manifest signing tests: tests/* stops git descending, so each level is
# re-opened explicitly and re-narrowed immediately after.
!tests/Modules/
tests/Modules/*
!tests/Modules/Settings/
tests/Modules/Settings/*
!tests/Modules/Settings/Update*Test.php
!tests/Modules/Settings/ManifestVerifier*Test.php
!tests/Modules/Settings/ReleaseManifest*Test.php
# Media upload gate regression locks.
!tests/Modules/Media/
tests/Modules/Media/*
!tests/Modules/Media/*Test.php
# Fileeditor write-allowlist (BLOKER-2) regression locks.
!tests/Modules/Fileeditor/
tests/Modules/Fileeditor/*
!tests/Modules/Fileeditor/*Test.php
# Users permgroup privilege-escalation (BLOKER-1) regression locks.
!tests/Modules/Users/
tests/Modules/Users/*
!tests/Modules/Users/*Test.php
# Methods ModuleInstaller namespace regression locks.
!tests/Modules/Methods/
tests/Modules/Methods/*
!tests/Modules/Methods/*Test.php
# Notifications realtime/composer/preference test-infrastructure locks.
!tests/Modules/Notifications/
tests/Modules/Notifications/*
!tests/Modules/Notifications/*Test.php
# MigrationManager modul/seed regression locks.
!tests/Modules/MigrationManager/
tests/Modules/MigrationManager/*
!tests/Modules/MigrationManager/*Test.php
# Auth unique-key migration (IP-3/Gorev 10) regression locks.
!tests/Modules/Auth/
tests/Modules/Auth/*
!tests/Modules/Auth/*Test.php
# ci4ms:migrate command regression locks.
!tests/Modules/Backend/
tests/Modules/Backend/*
!tests/Modules/Backend/*Test.php
# Backup restore authz (F2) regression locks.
!tests/Modules/Backup/
tests/Modules/Backup/*
!tests/Modules/Backup/*Test.php
# Logs view XSS escaping (F5) regression locks.
!tests/Modules/Logs/
tests/Modules/Logs/*
