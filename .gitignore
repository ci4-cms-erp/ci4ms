!tests/_support/Notifications/
tests/_support/Notifications/*
!tests/_support/Notifications/*.php
# Feature-level regression suites (Install/Security/Media) were pre-existing
# on disk but never whitelisted since tests/* was added: entire directory was
# git-invisible (git ls-files returned empty), same defect class as BLOKER-A.
!tests/Feature/
tests/Feature/*
!tests/Feature/*Test.php
# Unit tests (helper/library behaviour locks) were git-invisible under tests/*.
!tests/unit/
tests/unit/*
!tests/unit/*Test.php
phpunit.xml.dist
node_modules
.security-audit
graphify-out
