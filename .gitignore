# db_connect -> CommonModel query-equivalence locks.
!tests/Modules/Pages/
tests/Modules/Pages/*
!tests/Modules/Pages/*Test.php
!tests/Modules/LanguageManager/
tests/Modules/LanguageManager/*
!tests/Modules/LanguageManager/*Test.php
